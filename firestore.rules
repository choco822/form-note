rules_version = '2';
// フォーム解析ノート（仮バージョン）のデータの守り方
// - アプリを開いた人は自動で匿名ログインする（メールアドレスもパスワードも不要）
// - アプリから開いた人は全員、全部の記録・短い動画・選手の名簿を見る・追加する・消すことができる
// - アプリを通さない直接のアクセス（ログインしていないもの）は断る
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /records/{rid} {
      allow read, delete: if signedIn();
      allow create: if signedIn()
        && request.resource.data.kind in ['swing', 'speed']
        && request.resource.data.player is string
        && request.resource.data.player.size() <= 40;
      allow update: if false;
    }

    // 記録に付けた短い動画（1件1MBの制限があるので、分けて保存する）
    match /clips/{cid} {
      allow read, delete: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['rid', 'i', 'n', 'mime', 'data', 'createdAt'])
        && request.resource.data.rid is string
        && request.resource.data.i is int && request.resource.data.n is int
        && request.resource.data.n <= 4
        && request.resource.data.mime is string
        && request.resource.data.data is string && request.resource.data.data.size() <= 750000;
      allow update: if false;
    }

    // 選手の名簿（自チーム・相手チーム）。team が空なら自チーム
    function validPlayer(d) {
      return d.keys().hasOnly(['name', 'createdAt', 'team', 'number', 'throws', 'bats'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && (!('team' in d) || (d.team is string && d.team.size() <= 40))
        && (!('number' in d) || (d.number is string && d.number.size() <= 4))
        && (!('throws' in d) || d.throws in ['R', 'L'])
        && (!('bats' in d) || d.bats in ['R', 'L', 'S']);
    }
    match /players/{pid} {
      allow read, delete: if signedIn();
      allow create, update: if signedIn() && validPlayer(request.resource.data);
    }

    // 一球チャート：試合（打順や今のカウントなども入る）
    match /games/{gid} {
      allow read, delete: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.opponent is string && request.resource.data.opponent.size() <= 40
        && request.resource.data.date is string;
    }
    // 一球チャート：1球ずつの記録（試合後に動画を見ながら、球種やコースを足すこともある）
    function validPitch(d) {
      return d.gameId is string && d.seq is int
        && d.result in ['B', 'CS', 'SS', 'F', 'X', 'HBP'];
    }
    match /pitches/{id} {
      allow read, delete: if signedIn();
      allow create: if signedIn() && validPitch(request.resource.data);
      allow update: if signedIn() && validPitch(request.resource.data)
        && request.resource.data.gameId == resource.data.gameId;
    }
    // 設定（球種の一覧など）
    match /settings/{key} {
      allow read: if signedIn();
      allow create, update: if signedIn() && key in ['pitchTypes'] && request.resource.data.types is list && request.resource.data.types.size() <= 40;
      allow delete: if false;
    }
  }
}
